import java.util.Scanner;
public class HomeTask05{
  public static void main(String[]arg){
    Scanner sc= new Scanner(System.in);
    String s1= sc.nextLine();
    int count = 0;
    for(int i= (s1.length()-1); i>=0; i--){
      char c = s1.charAt(i);
      if(c== ' '){
        break;
      }
      else{
        count++;
      }
    }
    System.out.print(count);
  }
}
