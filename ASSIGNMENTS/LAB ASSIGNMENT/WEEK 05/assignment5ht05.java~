import java.util.Scanner;

public class assignment5ht05 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // Get the number of rows from the user
        System.out.print("Enter N: ");
        int n = sc.nextInt();

        // Outer loop: Controls the Rows (from 1 to N)
        for (int i = 1; i <= n; i++) {
            
            // 1. Inner loop: Prints Leading Spaces
            // As row number increases, spaces decrease
            for (int s = 1; s <= n - i; s++) {
                System.out.print(" ");
            }

            // 2. Inner loop: Prints Ascending Numbers (1 to i)
            // Example: If row is 3, prints "123"
            for (int j = 1; j <= i; j++) {
                System.out.print(j);
            }

            // 3. Inner loop: Prints Descending Numbers (i-1 down to 1)
            // Example: If row is 3, prints "21"
            for (int k = i - 1; k >= 1; k--) {
                System.out.print(k);
            }

            // Move to the next line after finishing one row
            System.out.println();
        }
        
        sc.close();
    }
}