public class labtask05 {
    public static void main(String[] args) {
        System.out.print("Enter pattern number(N):");
        int N = 3;
        for(int i =1;i<=N;i++){
            for(int space=1;space<=(N-i);space++){
                System.out.print(" ");
            }
            for(int j =1;j<=(2*i-1);j++){
                System.out.print(j);
            }
            System.out.println();
        }
    }
}