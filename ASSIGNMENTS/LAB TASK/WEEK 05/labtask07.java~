/*
1
1 2
1   3
1     4
1 2 3 4 5
Logic: Print 1 at the beginning of each row,
print the row number at the end of each row, 
and print spaces in between for rows other than
if(j==1||j==i||i==N)
*/

public class labtask07 {
    public static void main(String[] args) {
        int N =5;
        for(int i =1;i<=N;i++){
            for(int j =1;j<=i;j++){
                if(j==1||j==i||i==N){
                    System.out.print(j);
                }
                else{
                    System.out.print(" ");
                }
            }
            System.out.println();
        }
    }
}
